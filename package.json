{
  "name": "focus-rhythm",
  "version": "0.1.0-beta",
  "description": "Native Ubuntu desktop Pomodoro timer with a Cyberpunk visual identity",
  "author": {
    "name": "Muhammad Umar",
    "email": "hafiz.mumer03@gmail.com"
  },
  "homepage": "https://github.com/muhammad-umar/focus-rhythm",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELEC\" -c \"cyan.bold,green.bold\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "tsc && vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder --linux deb",
    "dist:all": "npm run build && electron-builder --linux deb AppImage",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.focusrhythm.app",
    "productName": "Focus Rhythm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Muhammad Umar <hafiz.mumer03@gmail.com>",
      "icon": "build/icon.png"
    },
    "deb": {
      "priority": "optional"
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/orbitron": "^5.2.5",
    "@fontsource/share-tech-mono": "^5.2.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.5.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
